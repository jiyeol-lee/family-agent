{
  "name": "family-agent-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply family-agent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-agent-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
